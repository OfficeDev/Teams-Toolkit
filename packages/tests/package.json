{
  "name": "@microsoft/teamsfx-test",
  "version": "0.1.19",
  "description": "A UI Test Project of Teams Toolkit Extension",
  "private": true,
  "author": "Microsoft Corporation",
  "license": "MIT",
  "scripts": {
    "build": "rimraf out && tsc -p ./",
    "test:e2e": "npm run test:e2e:clean && npm run test:e2e:parallel",
    "test:e2e:clean": "NODE_OPTIONS=\"--unhandled-rejections=strict\" ts-node --require ./src/e2e/setup.ts src/e2e/clean.ts",
    "test:e2e:parallel": "mocha --parallel --exit --reporter @mochajs/json-file-reporter \"src/e2e/**/*.tests.ts\"",
    "test:e2e:smoke": "mocha --exit --reporter @mochajs/json-file-reporter \"src/e2e/smoke/*.tests.ts\"",
    "test:e2e:others": "mocha --exit --reporter @mochajs/json-file-reporter \"src/e2e/{,!(smoke)}/*.tests.ts\"",
    "generate:vscuse-cases": "node -e \"require('./vscuse/vscode-test-cases/engine/index.cjs').setupGeneratedPlans().then((result) => { if (!result.ok) { console.error(JSON.stringify(result.diagnostics, null, 2)); process.exitCode = 1; } })\"",
    "test:vscuse-engine": "node --test vscuse/vscode-test-cases/engine/*.test.cjs vscuse/vscode-test-cases/components/lifecycle-components.test.cjs",
    "precommit": "lint-staged"
  },
  "devDependencies": {
    "@microsoft/dev-tunnels-connections": "1.1.9",
    "@microsoft/dev-tunnels-contracts": "1.1.9",
    "@microsoft/dev-tunnels-management": "1.1.9",
    "@microsoft/dev-tunnels-ssh": "3.11.36",
    "@microsoft/extra-shot-mocha": "0.0.1",
    "@microsoft/teamsfx-core": "workspace:*",
    "@types/adm-zip": "0.5.5",
    "@types/chai": "^4.2.19",
    "@types/fs-extra": "^11.0.4",
    "@types/glob": "^7.1.3",
    "@types/keytar": "^4.4.2",
    "@types/md5": "^2.3.0",
    "@types/mocha": "^10.0.10",
    "@types/mochawesome": "^6.2.1",
    "@types/mssql": "^8.1.2",
    "@types/node": "^22.15.0",
    "@types/uuid": "^8.3.0",
    "azure-devops-node-api": "^15.1.0",
    "chai": "^4.3.4",
    "chai-as-promised": "^7.1.1",
    "chai-spies": "^1.0.0",
    "env-cmd": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-headers": "^1.3.4",
    "eslint-plugin-import-x": "^4.16.0",
    "eslint-plugin-local-rules": "^1.3.2",
    "eslint-plugin-no-secrets": "^1.1.2",
    "eslint-plugin-prettier": "^5.5.0",
    "glob": "^7.1.6",
    "globals": "^16.2.0",
    "husky": "^8.0.3",
    "lint-staged": "^10.5.4",
    "mocha": "^11.0.0",
    "mocha-junit-reporter": "^2.0.2",
    "mochawesome": "7.0.1",
    "mock-fs": "^5.1.2",
    "mocked-env": "^1.3.5",
    "mssql": "^9.1.1",
    "mustache": "^4.2.0",
    "nyc": "^17.1.0",
    "playwright": "^1.44.1",
    "prettier": "^3.0.0",
    "rimraf": "^3.0.2",
    "sinon": "^19.0.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.3.1",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.56.0",
    "uuid": "^11.1.1",
    "vscode-extension-tester": "^8.2.0"
  },
  "dependencies": {
    "@azure/arm-apimanagement": "^8.0.0",
    "@azure/arm-resources": "5.0.1",
    "@azure/arm-sql": "^9.0.0",
    "@azure/identity": "^4.1.0",
    "@azure/msal-node": "2.6.6",
    "@microsoft/m365agentstoolkit-cli": "workspace:*",
    "@microsoft/teamsfx-api": "workspace:*",
    "@types/js-yaml": "^4.0.0",
    "@types/semver": "^7.3.8",
    "adm-zip": "0.6.0",
    "axios": "^1.6.8",
    "dotenv": "^8.2.0",
    "form-data": "4.0.0",
    "fs-extra": "^11.3.2",
    "is-wsl": "^2.2.0",
    "js-yaml": "^4.3.0",
    "md5": "^2.3.0",
    "querystring": "^0.2.1",
    "semver": "^7.5.2",
    "strip-bom": "4",
    "tmp": "^0.2.5",
    "yaml": "^2.8.3"
  },
  "optionalDependencies": {
    "keytar": "^7.7.0"
  },
  "lint-staged": {
    "*.{js,jsx,css,ts,tsx}": [
      "eslint --cache --fix --quiet",
      "prettier --cache --write --ignore-unknown"
    ]
  }
}
