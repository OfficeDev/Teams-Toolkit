{
  "$schema": "../../../schema/descriptor.schema.json",
  "id": "da/mcp-server",
  "name": "Declarative Agent with MCP Server",
  "languages": ["common"],
  "minEngineVersion": "6.11.0",
  "spec": "docs/03-specs/scenarios/da/create-mcp-server.md",
  "requiresNetwork": false,

  "optionsSchema": {
    "type": "object",
    "required": ["mcpServerType"],
    "properties": {
      "mcpServerType": { "enum": ["local", "remote"], "default": "remote" },
      "mcpServerUrl": { "type": "string", "format": "uri" },
      "authType": { "enum": ["none", "oauth", "entra-sso", "oauth-dynamic"], "default": "oauth" },
      "selectedLocalServers": { "type": "array", "items": { "type": "string" } },
      "oauthClientId": { "type": "string", "pattern": "\\S" },
      "oauthClientSecret": { "type": "string", "pattern": "\\S" },
      "oauthScopes": { "type": "string" },
      "entraClientId": { "type": "string", "pattern": "\\S" }
    },
    "allOf": [
      {
        "if": { "properties": { "mcpServerType": { "const": "remote" } } },
        "then": { "required": ["mcpServerUrl", "authType"] }
      },
      {
        "if": { "properties": { "mcpServerType": { "const": "local" } } },
        "then": { "required": ["selectedLocalServers"] }
      },
      {
        "if": {
          "required": ["authType"],
          "properties": { "authType": { "const": "oauth" } }
        },
        "then": { "required": ["oauthClientId", "oauthClientSecret"] }
      },
      {
        "if": {
          "required": ["authType"],
          "properties": { "authType": { "const": "entra-sso" } }
        },
        "then": { "required": ["entraClientId"] }
      }
    ],
    "additionalProperties": false
  },

  "replaceMap": [
    { "var": "MCPForDAServerUrl", "from": "mcpServerUrl" },
    { "var": "OAuthClientId", "from": "oauthClientId" },
    { "var": "OAuthClientSecret", "from": "oauthClientSecret" },
    { "var": "OAuthScopes", "from": "oauthScopes" },
    { "var": "EntraClientId", "from": "entraClientId" },
    { "var": "IsLocalMCP", "when": "mcpServerType == 'local'", "value": "true" },
    { "var": "IsNoAuth", "when": "authType == 'none'", "value": "true" },
    { "var": "MicrosoftEntra", "when": "authType == 'entra-sso'", "value": "true" },
    { "var": "MCPNamespace", "expr": "mcpNamespace(mcpServerUrl)" },
    { "var": "MCPAuthRefId", "expr": "mcpAuthRef(mcpServerUrl)" }
  ]
}
