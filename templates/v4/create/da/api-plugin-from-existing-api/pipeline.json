{
  "pipeline": "default",
  "comment": "Render the common declarative-agent shell, generate the API plugin files from selected OpenAPI operations, then optionally apply the feature-gated sensitivity label.",
  "steps": [
    { "step": "require-empty-target" },
    {
      "step": "openapi/generate-plugin-files",
      "with": {
        "apiSpecLocation": "{{apiSpecLocation}}",
        "apiOperations": "{{apiOperations}}"
      }
    },
    {
      "step": "da/set-sensitivity-label",
      "when": "featureFlag('TEAMSFX_SENSITIVITY_LABEL')",
      "with": {
        "manifestPath": "appPackage/declarativeAgent.json"
      }
    }
  ]
}
